10 REM A tour of MINI09 BASIC
20 CLS:PRINT "MINI09 BASIC":PRINT
30 READ N:DIM FR$(N),QT(N):T=0
40 FOR I=1 TO N:READ FR$(I),QT(I):T=T+QT(I):NEXT
50 FOR I=N TO 1 STEP -1:PRINT FR$(I);TAB(12);QT(I):NEXT:PRINT "Total";TAB(12);T
60 DATA 3,"Apples",12,"Pears",7,Plums,23
70 A$="":FOR I=1 TO 5:A$=A$+CHR$(64+I):NEXT:PRINT A$;" ";MID$(A$,2,3)
80 FOR I=1 TO 3:ON I GOSUB 200,210,220:NEXT
90 PRINT "Hex &H7FFF = ";&H7FFF;", 17 MOD 5 = ";17 MOD 5
100 PRINT "Press a key...";
110 K$=INKEY$:IF K$="" THEN 110
120 PRINT " you pressed ";ASC(K$)
130 END
200 PRINT "one ";:RETURN
210 PRINT "two ";:RETURN
220 PRINT "three":RETURN
